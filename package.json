{
  "name": "@tangentmochi/jsontide",
  "version": "0.1.0",
  "description": "Type-safe streaming JSON parser: parse JSON incrementally from AsyncIterable or ReadableStream and validate it with any Standard Schema (Zod, Valibot, ArkType)",
  "author": {
    "name": "TangentMochi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TeamMoromen/jsontide.git"
  },
  "keywords": [
    "json",
    "streaming",
    "partial-json",
    "incremental",
    "parser",
    "standard-schema",
    "zod",
    "valibot",
    "arktype",
    "llm"
  ],
  "bugs": {
    "url": "https://github.com/TeamMoromen/jsontide/issues"
  },
  "homepage": "https://github.com/TeamMoromen/jsontide#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  }
}
