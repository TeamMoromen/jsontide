{
  "name": "jsontide",
  "version": "0.1.0",
  "description": "Type-safe streaming JSON parser: parse JSON incrementally from AsyncIterable or ReadableStream and validate it with any Standard Schema (Zod, Valibot, ArkType)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  }
}
